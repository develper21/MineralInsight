# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mineralinsight
DB_USER=postgres
DB_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/mineralinsight

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# API Keys
DGCI&S_API_KEY=your-dgcis-api-key
MINISTRY_COMMERCE_API_KEY=your-ministry-commerce-api-key
TEXMIN_API_KEY=your-texmin-api-key

# External API URLs
DGCI&S_BASE_URL=https://dgcis.gov.in/api
MINISTRY_COMMERCE_BASE_URL=https://commerce.gov.in/api
TEXMIN_BASE_URL=https://texmin.gov.in/api

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Monitoring
SENTRY_DSN=your-sentry-dsn
ENABLE_METRICS=true

# Data Processing
DATA_SYNC_INTERVAL=0 2 * * *
DATA_RETENTION_DAYS=365
BATCH_SIZE=1000

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Development
DEBUG=mineralinsight:*
MOCK_DATA=true
ENABLE_SWAGGER=true
