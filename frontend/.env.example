# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=10000

# Application Configuration
VITE_APP_NAME=MineralInsight
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Critical Mineral Intelligence Platform

# Data Sources
VITE_DATA_SOURCE=DGCI&S
VITE_DATA_REFRESH_INTERVAL=300000
VITE_LAST_UPDATED=2026-01-31

# Analytics and Monitoring
VITE_ENABLE_ANALYTICS=false
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_PRINT=true
VITE_ENABLE_SHARE=true

# Development
VITE_DEV_MODE=true
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# Map Configuration
VITE_MAP_API_KEY=
VITE_MAP_DEFAULT_LAT=20.5937
VITE_MAP_DEFAULT_LNG=78.9629
VITE_MAP_DEFAULT_ZOOM=5

# Chart Configuration
VITE_CHART_ANIMATION_DURATION=1000
VITE_CHART_DEFAULT_COLORS=copper,lithium,graphite

# Security
VITE_ENABLE_CSP=true
VITE_CORS_ORIGIN=http://localhost:5173

# Performance
VITE_ENABLE_LAZY_LOADING=true
VITE_CHUNK_SIZE_LIMIT=500000
VITE_ENABLE_CODE_SPLITTING=true

# Testing
VITE_TEST_MODE=false
VITE_MOCK_API=false
